{
  "name": "personal-task-board",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-local.mjs",
    "desktop:build": "zsh desktop/build-macos-app.sh",
    "desktop:install": "node desktop/install-macos-app.mjs",
    "desktop": "npm run desktop:build && npm run desktop:install",
    "windows:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/windows/build-windows.ps1",
    "windows": "npm run windows:build && start \"\" \"outputs\\windows\\win-x64\\PersonalTaskBoard.exe\"",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node scripts/run-local.mjs --production",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
